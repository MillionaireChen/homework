<mxfile host="app.diagrams.net" modified="2026-08-20T12:00:00.000Z" agent="claude-code" version="24.0.0">
  <diagram id="funnel-arch" name="Funnel Architecture">
    <mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Reference-free Summary Quality Funnel — every terminal decision is reviewer-confirmed" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Input is one (article, candidate summary) pair. No reference summary at any runtime stage." style="text;html=1;fontSize=12;align=center;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="60" y="48" width="980" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="LAYER 1 — PHYSICAL HARD CONSTRAINTS (deterministic, no model)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A76D4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#1A4480;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="980" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="LAYER 2 — SEMANTIC HARD CONSTRAINT (agent judgment, still terminal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF0E6;strokeColor=#D98C3F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#8A4B00;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="980" height="250" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="LAYER 3 — SOFT SCORING (graded quality, survivors only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F6EC;strokeColor=#4C9A5E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#1F5B2E;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="980" height="290" as="geometry" />
        </mxCell>
        <mxCell id="lane4" value="OUTPUT — validation, ranking, reporting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0EDF7;strokeColor=#7B61A8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4A3373;" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="980" height="130" as="geometry" />
        </mxCell>

        <mxCell id="input" value="(article, candidate summary)&#xa;250 pairs = 50 articles x 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="125" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="hardgate" value="hard_gate.py — string tests only&#xa;empty / &gt;3 sentences / continuous copy /&#xa;trailing comma or unclosed delimiter&#xa;&lt;i&gt;proposes, never decides&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A76D4;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="118" width="240" height="64" as="geometry" />
        </mxCell>

        <mxCell id="rev1" value="summary-reviewer&#xa;terminal-result pass&#xa;&lt;i&gt;re-derives evidence itself&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C8A415;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="118" width="160" height="64" as="geometry" />
        </mxCell>

        <mxCell id="term1" value="TERMINAL&#xa;VERBATIM_SOURCE_COPY rank 1&#xa;OBVIOUS_TRUNCATION rank 2&#xa;OVER_SENTENCE_LIMIT rank 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C0392B;fontSize=10;fontColor=#7B241C;" vertex="1" parent="1">
          <mxGeometry x="800" y="112" width="210" height="76" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="Ordinary entity / number / quotation overlap is NOT copying. A particle ending is suspicion, not proof.&#xa;A reviewer REJECT sends the candidate onward instead of ending it." style="text;html=1;fontSize=9;fontColor=#5A6C7D;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="195" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="emb" value="embedding_gate.py (optional hint)&#xa;qwen3-embedding:0.6b, candidate vs ITS OWN article only&#xa;no cross-article rank, no margin — a production request has one article&#xa;&lt;b&gt;never terminal&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="318" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gate2" value="summary-grounding-gate (agent)&#xa;one question only: is the candidate grounded in its article?&#xa;OFF_TOPIC / FACTUAL_REVERSAL / FABRICATED_CONTENT&#xa;never sees the anchor, the rubric, or another article; never scores" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D98C3F;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="318" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rev2" value="summary-reviewer&#xa;grounding pass&#xa;reproduces both cited spans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C8A415;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="420" width="330" height="52" as="geometry" />
        </mxCell>

        <mxCell id="term2" value="TERMINAL rank 0&#xa;OFF_TOPIC&#xa;FACTUAL_REVERSAL&#xa;FABRICATED_CONTENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE3E3;strokeColor=#C0392B;fontSize=10;fontColor=#7B241C;" vertex="1" parent="1">
          <mxGeometry x="870" y="405" width="140" height="82" as="geometry" />
        </mxCell>

        <mxCell id="centrality" value="THE CENTRALITY BOUNDARY&#xa;Terminal only when the defect is CENTRAL: the main event negated, the outcome inverted, the core claim invented.&#xa;A wrong peripheral number, a wrong secondary entity, or one added unsupported detail stays GROUNDED&#xa;and becomes a faithfulness penalty during scoring." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D98C3F;dashed=1;fontSize=10;align=left;spacingLeft=10;fontColor=#8A4B00;" vertex="1" parent="1">
          <mxGeometry x="100" y="405" width="360" height="82" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="Why a separate agent: the most dangerous candidate is fluent, on-topic, correct length, no copying — and asserts the opposite of the article.&#xa;String rules cannot see it and embedding similarity stays HIGH precisely because the subject matter is right." style="text;html=1;fontSize=9;fontColor=#5A6C7D;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="497" width="910" height="30" as="geometry" />
        </mxCell>

        <mxCell id="anchor" value="anchor pass (article only)&#xa;main_event + key_facts + anchor_summary&#xa;one per article, cached, generated BEFORE seeing candidates&#xa;&lt;i&gt;a coverage aid, never ground truth&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A5E;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="595" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="scorer" value="summary-scorer&#xa;atomic claim checks with cited source spans&#xa;SUPPORTED / CONTRADICTED / NOT_IN_SOURCE&#xa;faithfulness 50 | coverage 30 | coherence 15 | conciseness 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A5E;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="595" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rev3" value="summary-reviewer&#xa;soft-score pass&#xa;rechecks every claim,&#xa;arithmetic and label band" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C8A415;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="592" width="200" height="76" as="geometry" />
        </mxCell>

        <mxCell id="backstop" value="SEMANTIC BACKSTOP&#xa;A claim-by-claim audit can expose what the gate missed. The Scorer may PROPOSE&#xa;FACTUAL_REVERSAL or FABRICATED_CONTENT; the Reviewer may ESCALATE.&#xa;In this run the backstop fired 4 times, all on candidates the grounding layer had released; 1 was confirmed terminal." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C8A415;dashed=1;fontSize=10;align=left;spacingLeft=10;fontColor=#7A5C00;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="670" height="72" as="geometry" />
        </mxCell>

        <mxCell id="bands" value="EXCELLENT 90-100&#xa;GOOD 75-89&#xa;FINE 65-74&#xa;MIXED 50-64&#xa;POOR 0-49" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F6EC;strokeColor=#4C9A5E;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="690" width="200" height="86" as="geometry" />
        </mxCell>

        <mxCell id="revise" value="REVISE — one Scorer revision, then reviewed again. Unresolved disagreement is preserved as LOW_CONFIDENCE, never silently averaged." style="text;html=1;fontSize=9;fontColor=#5A6C7D;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="790" width="910" height="20" as="geometry" />
        </mxCell>

        <mxCell id="validate" value="validate_result.py&#xa;schema, ranges,&#xa;dimension sums, trace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61A8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="905" width="180" height="58" as="geometry" />
        </mxCell>
        <mxCell id="rank" value="rank_results.py&#xa;within-article order:&#xa;terminal tiers first, then score" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61A8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="905" width="200" height="58" as="geometry" />
        </mxCell>
        <mxCell id="charts" value="make_report_charts.py&#xa;deterministic stats + charts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61A8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="905" width="190" height="58" as="geometry" />
        </mxCell>
        <mxCell id="reporter" value="summary-reporter&#xa;writes the conclusion only,&#xa;never invents a number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C8A415;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="905" width="220" height="58" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;" edge="1" parent="1" source="input" target="hardgate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;" edge="1" parent="1" source="hardgate" target="rev1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="APPROVE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C0392B;endArrow=block;fontSize=9;fontColor=#C0392B;" edge="1" parent="1" source="rev1" target="term1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="REJECT / passed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rev1" target="gate2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="240" /><mxPoint x="665" y="240" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="hint" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7F8C8D;dashed=1;endArrow=open;fontSize=9;" edge="1" parent="1" source="emb" target="gate2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;" edge="1" parent="1" source="gate2" target="rev2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="APPROVE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C0392B;endArrow=block;fontSize=9;fontColor=#C0392B;" edge="1" parent="1" source="rev2" target="term2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="GROUNDED / REJECT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="rev2" target="anchor"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="545" /><mxPoint x="250" y="545" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;" edge="1" parent="1" source="anchor" target="scorer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;endArrow=block;" edge="1" parent="1" source="scorer" target="rev3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="ESCALATE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C0392B;endArrow=block;dashed=1;fontSize=9;fontColor=#C0392B;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rev3" target="term2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="592" /><mxPoint x="1050" y="446" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="APPROVE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4C9A5E;endArrow=block;fontSize=9;fontColor=#1F5B2E;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="rev3" target="validate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="840" /><mxPoint x="190" y="840" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7B61A8;endArrow=block;" edge="1" parent="1" source="validate" target="rank"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7B61A8;endArrow=block;" edge="1" parent="1" source="rank" target="charts"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7B61A8;endArrow=block;" edge="1" parent="1" source="charts" target="reporter"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C0392B;endArrow=block;dashed=1;" edge="1" parent="1" source="term1" target="validate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="150" /><mxPoint x="1060" y="880" /><mxPoint x="60" y="880" /><mxPoint x="60" y="934" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
